# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Random string you choose yourself. Used to verify that webhook requests really
# come from Telegram. Set the same value when calling setWebhook (see README).
TELEGRAM_WEBHOOK_SECRET=

# Meera's Telegram chat id. When set, the bot ignores messages from any other chat.
# See README for how to find it. Leave blank while testing if you don't have it yet.
ALLOWED_CHAT_ID=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash if unset
GEMINI_MODEL=gemini-3.6-flash
